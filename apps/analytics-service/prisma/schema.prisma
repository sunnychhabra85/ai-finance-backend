generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/analytics-client"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"] 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  date        String
  raw         String
  amount      Float
  merchant    String
  category    String
  type        String
  fingerprint String

  @@unique([userId, fingerprint])
}


model CategorizationMemory {
  id        String @id @default(uuid())
  raw       String @unique
  merchant  String
  category  String
  type      String
}

