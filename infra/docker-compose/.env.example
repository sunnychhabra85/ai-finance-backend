# ============================================
# Copy this file to .env and fill in your values
# ============================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this

# OpenAI Configuration (for AI Service)
OPENAI_API_KEY=sk-your-openai-key-here

# AWS Configuration (for local development, use defaults)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_BROKERS=kafka:29092
KAFKA_GROUP_ID=ai-finance-consumer-group

# Services Ports
AUTH_SERVICE_PORT=3001
UPLOAD_SERVICE_PORT=3002
PARSER_WORKER_PORT=3003
ANALYTICS_SERVICE_PORT=3004
AI_SERVICE_PORT=3005
API_GATEWAY_PORT=80

# Logging
LOG_LEVEL=debug

# Environment
NODE_ENV=development