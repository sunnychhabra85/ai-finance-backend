{
  "name": "ai-finance-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -ws",
    "test": "echo \"Error: no test specified\" && exit 1",
    "auth-service": "npm run start --workspace=apps/auth-service",
    "auth:migrate": "set DATABASE_URL=postgresql://postgres:123456@localhost:5432/authservicedb && prisma migrate dev --schema=apps/auth-service/prisma/schema.prisma --name init",
    "auth:generate": "set DATABASE_URL=postgresql://postgres:123456@localhost:5432/authservicedb && prisma generate --schema=apps/auth-service/prisma/schema.prisma",
    "upload:migrate": "set DATABASE_URL=postgresql://postgres:123456@localhost:5432/uploadservicedb && npx prisma migrate dev --schema=apps/upload-service/prisma/schema.prisma --name init",
    "upload:generate": "set DATABASE_URL=postgresql://postgres:123456@localhost:5432/uploadservicedb && npx prisma generate --schema=apps/upload-service/prisma/schema.prisma",
    "upload-service": "npm run start --workspace=apps/upload-service",
    "parser-worker": "npm run start --workspace=apps/parser-worker",
    "analytics:generate": "set DATABASE_URL=postgresql://postgres:123456@localhost:5432/analyticsservicedb && npx prisma generate --schema=apps/analytics-service/prisma/schema.prisma",
    "analytics:migrate": "set DATABASE_URL=postgresql://postgres:123456@localhost:5432/analyticsservicedb && npx prisma migrate dev --schema=apps/analytics-service/prisma/schema.prisma --name init",
    "analytics-service": "npm run start --workspace=apps/analytics-service",
    "ai-chat-service": "npm run start --workspace=apps/ai-service",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "auth:studio": "prisma studio --schema=apps/auth-service/prisma/schema.prisma",
    "upload:studio": "prisma studio --schema=apps/upload-service/prisma/schema.prisma",
    "analytics:studio": "prisma studio --schema=apps/analytics-service/prisma/schema.prisma"
  },
