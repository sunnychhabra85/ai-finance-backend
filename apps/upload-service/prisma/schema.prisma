generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/upload-client"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"] 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Upload {
  id        String   @id @default(uuid())
  userId    String
  fileName  String
  fileSize  Int
  fileHash  String   @unique
  status    UploadStatus
  createdAt DateTime @default(now())

  @@index([userId])
}



enum UploadStatus {
  UPLOADED
  PROCESSING
  DONE
  FAILED
}
